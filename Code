# STEP 1: TEAM DATA FROM THE INTERNET

def fetch_team_info():
    """
    Fetch team info from football-data.org. Returns a dict mapping
    team name -> team info dict, or empty dict if the API fails.

    The API returns squad data, founding year, venue, etc. We use
    squad size as a small rating modifier in build_team() when the
    user passes use_api_data=True in the SimConfig.
    """
    url = f'{BASE_URL}/competitions/{COMPETITION_CODE}/teams'
    headers = {'X-Auth-Token': API_KEY}

    try:
        response = requests.get(url, headers=headers, timeout=10)
    except requests.exceptions.RequestException as e:
        print(f'Could not reach the API: {e}')
        return {}

    if response.status_code != 200:
        print(f'API returned an error (status {response.status_code})')
        return {}

    data = response.json()
    team_info = {}
    for team in data['teams']:
        team_info[team['name']] = team
    return team_info


def api_depth_modifier(team_name, api_data):
    if team_name not in api_data:
        return 0

    squad = api_data[team_name].get('squad', [])
    squad_size = len(squad)

    # Most national-team squads at the API level are 23-30 players.
    # Center on 26 and scale gently.
    return (squad_size - 26) * 0.1


# STEP 2: CONVERT FIFA RANKING TO TEAM RATING

def ranking_to_rating(rank):
    if rank <= 5:
        return 95 - (rank - 1)
    elif rank <= 15:
        return 90 - (rank - 5) * 0.8
    elif rank <= 30:
        return 82 - (rank - 15) * 0.6
    elif rank <= 60:
        return 73 - (rank - 30) * 0.3
    else:
        return max(60, 64 - (rank - 60) * 0.15)


def build_team(team_name, config, api_data=None):
    """
    Build a team dictionary using the team's real FIFA ranking,
    plus optional adjustments from API squad data.
    """
    rank = FIFA_RANKINGS.get(team_name, 80)
    base_rating = ranking_to_rating(rank)

    # Optional bump/penalty based on real squad data
    if config.use_api_data and api_data:
        base_rating += api_depth_modifier(team_name, api_data)

    # Split into offense and defense with small random variation —
    # some teams are more attack-minded than others
    offense = round(base_rating + random.uniform(-3, 3), 1)
    defense = round(base_rating + random.uniform(-3, 3), 1)

    return {
        'name': team_name,
        'fifa_rank': rank,
        'offense': offense,
        'defense': defense,
        'star_player_out': random.random() < config.injury_probability,
        'points': 0,
        'goals_for': 0,
        'goals_against': 0,
        'group': None,
    }


# STEP 3: CALCULATE EFFECTIVE MATCH RATING

def calculate_rating(team, config):
    """
    Compute a team's effective rating for one match.
    Combines offense + defense, then applies host-nation bonus and
    injury penalty if applicable.
    """
    rating = (team['offense'] + team['defense']) / 2

    if team['name'] in HOST_NATIONS:
        rating *= config.home_advantage

    if team['star_player_out']:
        rating *= config.injury_penalty

    return rating


# STEP 4: SIMULATE A SINGLE MATCH

def simulate_match(team_a, team_b, config, allow_draw):
    rating_a = calculate_rating(team_a, config)
    rating_b = calculate_rating(team_b, config)

    weighted_a = rating_a ** config.rating_exponent
    weighted_b = rating_b ** config.rating_exponent
    prob_a = weighted_a / (weighted_a + weighted_b)

    score_a = generate_score(prob_a)
    score_b = generate_score(1 - prob_a)

    if score_a > score_b:
        result = 'A'
    elif score_b > score_a:
        result = 'B'
    else:
        if allow_draw:
            result = 'DRAW'
        else:
            # Knockout — simulate penalty shootout, weighted by rating
            if random.random() < prob_a:
                result = 'A'
                score_a += 1
            else:
                result = 'B'
                score_b += 1

    return result, score_a, score_b


def generate_score(win_probability):

    #Generate a realistic soccer score (0-4 goals)

    if win_probability > 0.7:
        return random.choices([0, 1, 2, 3, 4], weights=[5, 20, 30, 30, 15])[0]
    elif win_probability > 0.55:
        return random.choices([0, 1, 2, 3, 4], weights=[10, 25, 30, 25, 10])[0]
    elif win_probability > 0.4:
        return random.choices([0, 1, 2, 3, 4], weights=[20, 35, 25, 15, 5])[0]
    else:
        return random.choices([0, 1, 2, 3, 4], weights=[35, 35, 20, 8, 2])[0]


# STEP 5: BUILD GROUPS FROM THE REAL DRAW

def build_tournament_groups(config, api_data=None):
    """Build tournament groups using the real 2026 World Cup draw."""
    groups = {}
    for group_letter, team_names in WORLD_CUP_2026_GROUPS.items():
        group_teams = []
        for name in team_names:
            team = build_team(name, config, api_data)
            team['group'] = group_letter
            group_teams.append(team)
        groups[group_letter] = group_teams
    return groups


# STEP 6: GROUP STAGE

def play_group_match(team_a, team_b, config, upset_log=None):
    result, score_a, score_b = simulate_match(
        team_a, team_b, config, allow_draw=True
    )

    team_a['goals_for'] += score_a
    team_a['goals_against'] += score_b
    team_b['goals_for'] += score_b
    team_b['goals_against'] += score_a

    if result == 'A':
        team_a['points'] += 3
    elif result == 'B':
        team_b['points'] += 3
    else:
        team_a['points'] += 1
        team_b['points'] += 1

    if upset_log is not None:
        upset_log.append(_is_upset(team_a, team_b, result))


def _is_upset(team_a, team_b, result):
    """
    Return True if the match was an "upset". We define an upset as a
    lower-ranked team beating (or drawing) a team ranked at least
    10 spots higher.
    """
    rank_gap = abs(team_a['fifa_rank'] - team_b['fifa_rank'])
    if rank_gap < 10:
        return False  # close in rank — not really an upset

    # Identify the favorite
    if team_a['fifa_rank'] < team_b['fifa_rank']:
        favorite_won = (result == 'A')
    else:
        favorite_won = (result == 'B')

    return not favorite_won


def play_group_stage(groups, config, verbose=True, upset_log=None):
    """
    Play all group-stage matches (round-robin within each group).
    Returns (group_winners, runners_up, third_place).
    """
    group_winners = []
    runners_up = []
    third_place = []

    for group_letter, group in groups.items():
        if verbose:
            print(f'\n--- GROUP {group_letter} ---')

        for i in range(len(group)):
            for j in range(i + 1, len(group)):
                play_group_match(group[i], group[j], config, upset_log)

        # Sort by points, then goal difference, then goals scored
        # (real FIFA tiebreaker rules)
        group.sort(
            key=lambda t: (
                t['points'],
                t['goals_for'] - t['goals_against'],
                t['goals_for'],
            ),
            reverse=True,
        )

        if verbose:
            print(f"{'Team':<22}{'FIFA':<6}{'Pts':<5}"
                  f"{'GF':<5}{'GA':<5}{'GD':<5}")
            for team in group:
                gd = team['goals_for'] - team['goals_against']
                print(f"{team['name']:<22}#{team['fifa_rank']:<5}"
                      f"{team['points']:<5}{team['goals_for']:<5}"
                      f"{team['goals_against']:<5}{gd:<5}")

        group_winners.append(group[0])
        runners_up.append(group[1])
        third_place.append(group[2])

    return group_winners, runners_up, third_place


def select_best_third_place_teams(third_place_teams):
    """
    Pick the 8 best third-place teams using FIFA tiebreaker rules:
    points, then goal difference, then goals scored.
    """
    ranked = sorted(
        third_place_teams,
        key=lambda t: (
            t['points'],
            t['goals_for'] - t['goals_against'],
            t['goals_for'],
        ),
        reverse=True,
    )
    return ranked[:BEST_THIRDS_ADVANCING]


# STEP 7: KNOCKOUT STAGE

def play_knockout_round(teams, round_name, config,
                        verbose=True, upset_log=None):
    if verbose:
        print(f'\n========== {round_name} ==========')
    winners = []

    for i in range(0, len(teams), 2):
        team_a = teams[i]
        team_b = teams[i + 1]

        result, score_a, score_b = simulate_match(
            team_a, team_b, config, allow_draw=False
        )
        winner = team_a if result == 'A' else team_b

        if upset_log is not None:
            upset_log.append(_is_upset(team_a, team_b, result))

        if verbose:
            print(f"{team_a['name']} (#{team_a['fifa_rank']}) "
                  f"{score_a} - {score_b} "
                  f"{team_b['name']} (#{team_b['fifa_rank']})"
                  f"   -->  {winner['name']} advances")
        winners.append(winner)

    return winners


# STEP 8: MAIN TOURNAMENT

def run_tournament(config=None, verbose=True, api_data=None):
    #Run the entire 2026 World Cup simulation from start to finish.

    if config is None:
        config = SimConfig()

    upset_log = []

    if verbose:
        print('=' * 60)
        print('        2026 FIFA WORLD CUP SIMULATOR')
        print('        Hosts: Canada, Mexico, USA')
        print('        Using real FIFA rankings (April 2026)')
        print('=' * 60)

    groups = build_tournament_groups(config, api_data)

    if verbose:
        print('\n' + '=' * 60)
        print('                  GROUP STAGE')
        print('=' * 60)
    winners, runners_up, thirds = play_group_stage(
        groups, config, verbose=verbose, upset_log=upset_log
    )

    best_thirds = select_best_third_place_teams(thirds)
    if verbose:
        print('\n--- 8 BEST THIRD-PLACE TEAMS ADVANCING ---')
        for team in best_thirds:
            gd = team['goals_for'] - team['goals_against']
            print(f"  {team['name']} (Group {team['group']}, "
                  f"FIFA #{team['fifa_rank']}) - "
                  f"{team['points']} pts, GD {gd:+d}")

    # Round of 32 — randomized pairing (simplified bracket)
    round_of_32 = winners + runners_up + best_thirds
    random.shuffle(round_of_32)

    if verbose:
        print('\n' + '=' * 60)
        print('                 KNOCKOUT STAGE')
        print('=' * 60)
    round_of_16 = play_knockout_round(
        round_of_32, 'ROUND OF 32', config, verbose, upset_log
    )
    quarterfinalists = play_knockout_round(
        round_of_16, 'ROUND OF 16', config, verbose, upset_log
    )
    semifinalists = play_knockout_round(
        quarterfinalists, 'QUARTERFINALS', config, verbose, upset_log
    )
    finalists = play_knockout_round(
        semifinalists, 'SEMIFINALS', config, verbose, upset_log
    )
    champion_list = play_knockout_round(
        finalists, 'FINAL', config, verbose, upset_log
    )

    champion = champion_list[0]

    if verbose:
        print('\n' + '=' * 60)
        print(f'     2026 WORLD CUP CHAMPION: {champion["name"]}!')
        print('=' * 60)
        print(f"FIFA Ranking: #{champion['fifa_rank']}")
        print(f"Group: {champion['group']}")
        print(f"Offense: {champion['offense']}, "
              f"Defense: {champion['defense']}")
        if champion['name'] in HOST_NATIONS:
            print('(Won on home soil!)')
        if champion['star_player_out']:
            print('(Won despite missing a star player!)')

    return {
        'champion': champion['name'],
        'champion_rank': champion['fifa_rank'],
        'num_upsets': sum(upset_log),
        'total_matches': len(upset_log),
    }


def main():
    print('Fetching team data from football-data.org...')
    api_data = fetch_team_info()
    if api_data:
        print(f'Successfully loaded data for {len(api_data)} teams.')
        config = SimConfig(use_api_data=True)
    else:
        print('Proceeding with built-in FIFA rankings only.')
        config = SimConfig(use_api_data=False)

    run_tournament(config=config, verbose=True, api_data=api_data)


if __name__ == '__main__':
    main()
